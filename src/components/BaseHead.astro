---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { localizePath, type Locale } from '../i18n/ui';

export interface Props {
	title: string;
	description: string;
	image?: string;
	ogType?: string;
	locale?: Locale;
	basePath?: string;
	/** Error pages (404) must not advertise canonical/alternate URLs that do not exist. */
	suppressAlternates?: boolean;
}

const {
	title,
	description,
	image = '/og.png',
	ogType = 'website',
	locale = 'en',
	basePath = '/',
	suppressAlternates = false,
} = Astro.props;
const canonicalURL =
	!suppressAlternates && Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;

const siteURL = Astro.site?.href ?? Astro.url.origin;
const alternateEn =
	!suppressAlternates && Astro.site ? new URL(localizePath('en', basePath), Astro.site) : undefined;
const alternateJa =
	!suppressAlternates && Astro.site ? new URL(localizePath('ja', basePath), Astro.site) : undefined;

const personLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: '奥河 董馬',
	alternateName: 'Toma Okugawa',
	url: siteURL,
	affiliation: {
		'@type': 'CollegeOrUniversity',
		name: 'National Institute of Technology (KOSEN), Yuge College',
	},
	sameAs: [
		'https://researchmap.jp/t_okugawa',
		'https://orcid.org/0009-0007-3553-0617',
		'https://jglobal.jst.go.jp/detail?JGLOBAL_ID=202601005443166280',
		'https://github.com/toma-okugawa',
		'https://speakerdeck.com/t_okugawa',
	],
};
const websiteLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: locale === 'ja' ? '奥河 董馬 | ポートフォリオ' : 'Toma Okugawa | Portfolio',
	alternateName: locale === 'ja' ? 'Toma Okugawa | Portfolio' : '奥河 董馬 ポートフォリオ',
	inLanguage: locale,
	url: siteURL,
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="theme-color" content="#00489D" />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{canonicalURL && <link rel="canonical" href={canonicalURL} />}
{alternateEn && <link rel="alternate" hreflang="en" href={alternateEn} />}
{alternateJa && <link rel="alternate" hreflang="ja" href={alternateJa} />}
{alternateEn && <link rel="alternate" hreflang="x-default" href={alternateEn} />}

<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
<meta property="og:locale" content={locale === 'ja' ? 'ja_JP' : 'en_US'} />
<meta property="og:locale:alternate" content={locale === 'ja' ? 'en_US' : 'ja_JP'} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.url)} />

<script is:inline type="application/ld+json" set:html={JSON.stringify(personLd)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
