---
import SideBarMenu from "./SideBarMenu.astro";
import { CONTACT_EMAIL, RESEARCHMAP_URL, ORCID_URL, GITHUB_URL } from "../config";
const { sideBarActiveItemID } = Astro.props;

const researchInterests = [
  "Pose Estimation",
  "Motion Analysis",
  "Self-Directed Learning Support",
  "Real-Time Feedback",
  "Sports Engineering",
];
---

<div class="drawer-side z-40 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
  <label for="my-drawer" class="drawer-overlay" aria-label="Close sidebar"></label>
  <aside
    class="relative m-3 lg:m-4 lg:mr-0 rounded-2xl shadow-md px-6 pt-2 pb-10 h-auto min-h-[calc(100%-1.5rem)] lg:min-h-[calc(100%-2rem)] w-80 bg-primary text-primary-content flex flex-col"
  >
    <a
      href={`mailto:${CONTACT_EMAIL}`}
      onclick="event.preventDefault(); openMailModal();"
      class="btn btn-circle btn-sm btn-ghost border border-primary-content/40 text-primary-content hover:bg-primary-content hover:border-primary-content hover:text-primary absolute top-4 left-4"
      aria-label="Send an email"
      title="Send an email"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" style="fill: currentColor;"
        ><path
          d="M20 4H4c-1.103 0-2 .897-2 2v12c0 1.103.897 2 2 2h16c1.103 0 2-.897 2-2V6c0-1.103-.897-2-2-2zm0 2v.511l-8 6.223-8-6.222V6h16zM4 18V9.044l7.386 5.745a.994.994 0 0 0 1.228 0L20 9.044 20.002 18H4z"
        ></path></svg
      >
    </a>
    <a
      href={RESEARCHMAP_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-circle btn-sm btn-ghost border border-primary-content/40 text-primary-content hover:bg-primary-content hover:border-primary-content hover:text-primary absolute top-4 right-4"
      aria-label="researchmap profile"
      title="researchmap profile"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24">
        <text
          x="12"
          y="17"
          text-anchor="middle"
          font-family="Georgia, 'Times New Roman', serif"
          font-size="16"
          font-weight="bold"
          fill="currentColor">R</text
        >
      </svg>
    </a>

    <div class="w-fit mx-auto mt-8 mb-3">
      <a href="/">
        <div class="avatar block m-auto">
          <div class="w-32 ring-4 ring-primary-content/90 rounded-full">
            <img
              class="mask mask-circle"
              width="300"
              height="300"
              src="/profile.webp"
              alt="Portrait of Toma Okugawa"
            />
          </div>
        </div>
      </a>
    </div>
    <div class="text-center mb-4 px-2">
      <div class="text-xl font-bold tracking-wider">Toma Okugawa</div>
      <div class="text-sm text-primary-content/85" lang="ja">奥河 董馬</div>
      <p class="text-sm tracking-wide text-primary-content/85 mt-2">Student Researcher</p>
      <p class="text-xs text-primary-content/60 mt-0.5">NIT (KOSEN), Yuge College</p>
    </div>

    <SideBarMenu sideBarActiveItemID={sideBarActiveItemID} />

    <div class="text-left mt-6">
      <h3 class="text-xs font-bold uppercase tracking-widest border-b-2 border-primary-content/30 pb-1.5 mb-3">
        Contact
      </h3>
      <ul class="space-y-2.5 text-sm">
        <li class="flex items-center gap-2.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" class="shrink-0 opacity-70" style="fill: currentColor;"
            ><path
              d="M12 2C7.589 2 4 5.589 4 9.995 3.971 16.44 11.696 21.784 12 22c0 0 8.029-5.56 8-12 0-4.411-3.589-8-8-8zm0 12c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4z"
            ></path></svg
          >
          <span>Ehime, Japan</span>
        </li>
        <li class="flex items-center gap-2.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" class="shrink-0 opacity-70" style="fill: currentColor;"
            ><path
              d="M20 4H4c-1.103 0-2 .897-2 2v12c0 1.103.897 2 2 2h16c1.103 0 2-.897 2-2V6c0-1.103-.897-2-2-2zm0 2v.511l-8 6.223-8-6.222V6h16zM4 18V9.044l7.386 5.745a.994.994 0 0 0 1.228 0L20 9.044 20.002 18H4z"
            ></path></svg
          >
          <a
            href={`mailto:${CONTACT_EMAIL}`}
            onclick="event.preventDefault(); openMailModal();"
            class="hover:underline break-all">{CONTACT_EMAIL}</a
          >
        </li>
        <li class="flex items-center gap-2.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" class="shrink-0 opacity-70" style="fill: currentColor;"
            ><path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12.026 2c-5.509 0-9.974 4.465-9.974 9.974 0 4.406 2.857 8.145 6.821 9.465.499.09.679-.217.679-.481 0-.237-.008-.865-.011-1.696-2.775.602-3.361-1.338-3.361-1.338-.452-1.152-1.107-1.459-1.107-1.459-.905-.619.069-.605.069-.605 1.002.07 1.527 1.028 1.527 1.028.89 1.524 2.336 1.084 2.902.829.091-.645.351-1.085.635-1.334-2.214-.251-4.542-1.107-4.542-4.93 0-1.087.389-1.979 1.024-2.675-.101-.253-.446-1.268.099-2.64 0 0 .837-.269 2.742 1.021a9.582 9.582 0 0 1 2.496-.336 9.554 9.554 0 0 1 2.496.336c1.906-1.291 2.742-1.021 2.742-1.021.545 1.372.203 2.387.099 2.64.64.696 1.024 1.587 1.024 2.675 0 3.833-2.33 4.675-4.552 4.922.355.308.675.916.675 1.846 0 1.334-.012 2.41-.012 2.737 0 .267.178.577.687.479C19.146 20.115 22 16.379 22 11.974 22 6.465 17.535 2 12.026 2z"
            ></path></svg
          >
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="hover:underline break-all"
            >github.com/toma-okugawa</a
          >
        </li>
        <li class="flex items-center gap-2.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" class="shrink-0 opacity-70">
            <rect x="2.75" y="2.75" width="18.5" height="18.5" rx="4" fill="none" stroke="currentColor" stroke-width="2"></rect>
            <text x="12" y="16.5" text-anchor="middle" font-family="Georgia, 'Times New Roman', serif" font-size="12" font-weight="bold" fill="currentColor">R</text>
          </svg>
          <a href={RESEARCHMAP_URL} target="_blank" rel="noopener noreferrer" class="hover:underline break-all"
            >researchmap.jp/t_okugawa</a
          >
        </li>
        <li class="flex items-center gap-2.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" class="shrink-0 opacity-70">
            <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"></circle>
            <text x="12" y="15.5" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="9.5" font-weight="bold" fill="currentColor">iD</text>
          </svg>
          <a href={ORCID_URL} target="_blank" rel="noopener noreferrer" class="hover:underline break-all"
            >0009-0007-3553-0617</a
          >
        </li>
      </ul>
    </div>

    <div class="text-left mt-7">
      <h3 class="text-xs font-bold uppercase tracking-widest border-b-2 border-primary-content/30 pb-1.5 mb-3">
        Research Interests
      </h3>
      <ul class="flex flex-wrap gap-2">
        {
          researchInterests.map((keyword) => (
            <li class="bg-primary-content/10 border border-primary-content/25 rounded-full px-3 py-1 text-xs transition-colors hover:bg-primary-content/20">
              {keyword}
            </li>
          ))
        }
      </ul>
    </div>
  </aside>
</div>
