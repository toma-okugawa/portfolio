---
export interface Props {
  title: string;
  meta?: string;
  date?: string;
  badges?: string[];
  highlightBadges?: string[];
  links?: { label: string; url: string }[];
  url?: string;
  lang?: string;
  /** Ongoing item — green timeline dot plus a textual "Ongoing" cue. */
  active?: boolean;
  /** Optional abstract shown in a collapsible disclosure. */
  abstract?: string;
  /** Localized label for the abstract disclosure. */
  abstractLabel?: string;
  /** Localized label for the ongoing badge. */
  ongoingLabel?: string;
}

const {
  title,
  meta,
  date,
  badges = [],
  highlightBadges = [],
  links = [],
  url,
  lang,
  active = false,
  abstract,
  abstractLabel = "Abstract",
  ongoingLabel = "Ongoing",
} = Astro.props;

const badgeClass =
  "badge badge-sm bg-primary/10 text-primary border-primary/20 h-auto min-h-[1.25rem] max-w-full whitespace-normal py-0.5 leading-snug text-start";
---

<article class="relative ml-1.5 pl-4 sm:pl-6 pb-7 border-l-2 border-base-300 last:border-l-transparent last:pb-1">
  <span
    class:list={[
      "absolute -left-[7px] top-1 w-3 h-3 rounded-full border-2 border-base-100 outline outline-2",
      active ? "bg-success outline-success" : "bg-primary outline-primary",
    ]}
    aria-hidden="true"></span>
  {
    (date || active) && (
      <div class="mb-1.5 flex flex-wrap items-center gap-2">
        {date && (
          <span class="inline-block text-xs font-semibold text-base-content/70 bg-base-200 rounded px-2 py-0.5">
            {date}
          </span>
        )}
        {active && (
          <span class="badge badge-sm badge-outline text-success border-success/40 font-medium">{ongoingLabel}</span>
        )}
      </div>
    )
  }
  <h3 class="font-semibold leading-snug max-w-[75ch]" lang={lang}>
    {
      url ? (
        <a href={url} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">
          {title}
        </a>
      ) : (
        title
      )
    }
  </h3>
  {meta && <p class="text-sm text-base-content/70 mt-1 max-w-[75ch]">{meta}</p>}
  {
    Astro.slots.has("default") && (
      <div class="text-sm text-base-content/80 mt-1 leading-relaxed max-w-[75ch]">
        <slot />
      </div>
    )
  }
  {
    (badges.length > 0 || highlightBadges.length > 0 || links.length > 0) && (
      <div class="flex flex-wrap items-center gap-2 mt-2">
        {highlightBadges.map((badge) => (
          <span class="badge badge-primary badge-sm h-auto min-h-[1.25rem] max-w-full whitespace-normal py-0.5 leading-snug text-start">
            {badge}
          </span>
        ))}
        {badges.map((badge) => <span class={badgeClass}>{badge}</span>)}
        {links.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="link link-primary link-hover text-xs font-medium inline-flex items-center px-1.5 py-2 -my-2"
          >
            {link.label} ↗
          </a>
        ))}
      </div>
    )
  }
  {
    abstract && (
      <details class="collapse collapse-arrow border border-base-300 bg-base-100 mt-2 max-w-[75ch]">
        <summary class="collapse-title text-sm font-medium text-primary min-h-0 py-3 pr-10">{abstractLabel}</summary>
        <div class="collapse-content text-sm leading-relaxed text-base-content/80" lang={lang}>
          <p>{abstract}</p>
        </div>
      </details>
    )
  }
</article>
