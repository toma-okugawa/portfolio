---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageTitle from "../PageTitle.astro";
import SectionTitle from "../SectionTitle.astro";
import DataEntry from "../cv/DataEntry.astro";
import { RESEARCHMAP_URL } from "../../config";
import { useTranslations, type Locale } from "../../i18n/ui";
import { preprints, presentations, refereedPapers } from "../../data/entries";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout title={t("pubs.title")} sideBarActiveItemID="publications" locale={locale}>
  <PageTitle title={t("pubs.title")}>
    {
      locale === "ja" ? (
        <>
          完全なリストは
          <a href={RESEARCHMAP_URL} target="_blank" rel="noopener noreferrer" class="link link-primary">
            researchmap
          </a>
          でもご覧いただけます。
        </>
      ) : (
        <>
          A complete list is also available on
          <a href={RESEARCHMAP_URL} target="_blank" rel="noopener noreferrer" class="link link-primary">
            researchmap
          </a>
          .
        </>
      )
    }
  </PageTitle>

  <SectionTitle title={t("pubs.refereed")} id="refereed" />

  {refereedPapers.map((entry) => <DataEntry entry={entry} locale={locale} />)}

  <SectionTitle title={t("pubs.preprints")} id="preprints" />

  {preprints.map((entry) => <DataEntry entry={entry} locale={locale} />)}

  <SectionTitle title={t("pubs.presentations")} id="presentations" />

  {presentations.map((entry) => <DataEntry entry={entry} locale={locale} />)}
</BaseLayout>
