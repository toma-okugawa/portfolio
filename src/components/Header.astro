---
import LocaleSwitcher from "./LocaleSwitcher.astro";
import { localizePath, useTranslations, type Locale } from "../i18n/ui";

interface Props {
  showMenuButton?: boolean;
  locale?: Locale;
  basePath?: string;
}

const { showMenuButton = true, locale = "en", basePath = "/" } = Astro.props;
const t = useTranslations(locale);
---

<div
  class="site-header sticky lg:hidden top-0 z-30 flex h-16 w-full justify-center bg-opacity-90 backdrop-blur transition-all duration-100 bg-base-100 text-base-content shadow-sm"
>
  <div class="navbar">
    <div class="navbar-start">
      {
        showMenuButton && (
          <label for="my-drawer" class="btn btn-square btn-ghost drawer-button">
            <span class="sr-only">{t("header.menuLabel")}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              class="inline-block w-5 h-5 stroke-current"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </label>
        )
      }
    </div>
    <div class="navbar-center">
      <a class="btn btn-ghost normal-case text-xl" href={localizePath(locale, "/")}>{t("site.author")}</a>
    </div>
    <div class="navbar-end pr-2">
      <LocaleSwitcher locale={locale} basePath={basePath} />
    </div>
  </div>
</div>
