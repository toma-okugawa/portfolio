---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404: Not Found" includeSidebar={false}>
  <div class="flex min-h-[calc(100svh-16rem)] flex-col items-center justify-center text-center">
    <h1 class="text-7xl sm:text-8xl font-bold text-primary mb-4">404</h1>
    <h2 class="text-2xl mb-1">Page Not Found</h2>
    <p class="text-xl mb-4" lang="ja">ページが見つかりません</p>
    <p class="text-base-content/70">The page you're looking for doesn't exist or has been moved.</p>
    <p class="text-base-content/70" lang="ja">お探しのページは存在しないか、移動しました。</p>
    <div class="flex flex-wrap justify-center gap-3 mt-9">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn btn-outline btn-primary" href="/ja/" lang="ja">日本語ホーム</a>
    </div>
  </div>
</BaseLayout>
