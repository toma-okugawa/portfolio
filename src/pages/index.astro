---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Entry from "../components/cv/Entry.astro";
import { CONTACT_EMAIL, RESEARCHMAP_URL, ORCID_URL } from "../config";

const researchInterests = [
  "Pose Estimation",
  "Motion Analysis",
  "Self-Directed Learning Support System",
  "Real-Time Feedback",
  "Sports Engineering",
];
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-4 mt-5">
    <div class="text-lg font-medium text-primary py-1">Student Researcher</div>
    <h1 class="text-5xl font-bold">Toma Okugawa</h1>
    <div class="text-2xl py-3 text-base-content/80" lang="ja">奥河 董馬</div>
    <div class="text-base text-base-content/70">
      Department of Information Science and Technology,<br />
      National Institute of Technology (KOSEN), Yuge College
    </div>

    <p class="py-5 text-base leading-relaxed max-w-[68ch]">
      My research focuses on <b>human pose estimation</b> and <b>motion analysis</b> for self-directed learning
      support systems with real-time feedback, including applications in sports engineering such as Kyudo
      (Japanese archery) form evaluation. I also work on <b>low-light image enhancement</b>, where I have
      proposed the Retinex-based methods XCR and SD-Retinex.
    </p>

    <div class="flex flex-wrap gap-2 mb-8">
      {researchInterests.map((keyword) => <span class="badge badge-outline badge-primary">{keyword}</span>)}
    </div>

    <div class="flex flex-wrap gap-3">
      <a class="btn btn-primary" href={`mailto:${CONTACT_EMAIL}`}>Contact Me</a>
      <a class="btn btn-outline btn-primary" href={RESEARCHMAP_URL} target="_blank" rel="noopener noreferrer"
        >researchmap</a
      >
      <a class="btn btn-outline btn-primary" href={ORCID_URL} target="_blank" rel="noopener noreferrer">ORCID</a>
    </div>
  </div>

  <SectionTitle title="Selected Publications" />

  <Entry
    title="Re-Defining Vanishing Municipalities in Japan: A Multidimensional Clustering and SLM-Based Policy Insight Framework"
    meta="Toma Okugawa, Keito Inoshita — Proceedings of the IEEE 15th Global Conference on Consumer Electronics (IEEE GCCE)"
    date="Oct 2026"
    badges={["Refereed", "Lead author", "To appear"]}
  />
  <Entry
    title="SD-Retinex: A Stable Retinex Method for Low-Light Image Enhancement Designed Around the Sigmoid Derivative"
    meta="Toma Okugawa — Zenodo (preprint)"
    date="Jun 2026"
    badges={["Lead author", "Preprint"]}
    links={[{ label: "DOI", url: "https://doi.org/10.5281/ZENODO.20945211" }]}
  />
  <Entry
    title="リアルタイム姿勢推定による弓道フォーム評価手法の提案とWeb実装"
    meta="奥河 董馬, 益崎 智成, 牧山 隆洋 — 令和7年度 電気・電子・情報関係学会四国支部連合大会 (SJCIEE 2025)"
    date="Sep 2025"
    lang="ja"
    badges={["Refereed", "Lead author"]}
    highlightBadges={["Outstanding Presentation Award"]}
  />

  <div class="mt-4">
    <a href="/publications" class="link link-primary link-hover font-medium group"
      >View all publications <span class="inline-block transition-transform group-hover:translate-x-1">→</span></a
    >
  </div>

  <SectionTitle title="Recent Awards" />

  <Entry
    title="Tongali Business Plan Contest 2026 — 5th Place Tongali Award, NICT Award, and Supporter Awards"
    meta="Tongali Project, Nagoya University / National Institute of Information and Communications Technology (NICT)"
    date="Jun 2026"
  />
  <Entry
    title="SusHi Tech Teen Challenge 2026 Semifinalist"
    meta="SusHi Tech Tokyo 2026 Executive Committee"
    date="Apr 2026"
  />
  <Entry
    title="Fighting Spirit Award, The 36th KOSEN Programming Contest"
    meta="Japan Association of Colleges of Technology"
    date="Oct 2025"
  />

  <div class="mt-4">
    <a href="/cv#awards" class="link link-primary link-hover font-medium group"
      >View all awards <span class="inline-block transition-transform group-hover:translate-x-1">→</span></a
    >
  </div>
</BaseLayout>
