---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Entry from "../components/cv/Entry.astro";
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <div class="mb-5 mt-5">
    <h1 class="text-3xl font-bold">Projects</h1>
  </div>

  <SectionTitle title="Funded Research" id="funded-research" />

  <Entry
    title="夜間環境に特化した360度視覚支援型移動ロボットの開発"
    meta="AKATSUKI Project / LEADING EDGE Shikoku (Competitive Research Funds), Ministry of Economy, Trade and Industry — National Institute of Technology, Yuge College"
    date="Aug 2025 – Jan 2026"
    lang="ja"
    badges={["Principal Investigator"]}
  >
    Development of a 360-degree vision-assisted mobile robot specialized for nighttime environments, selected for
    METI's program for discovering and cultivating young local IT talent.
  </Entry>

  <SectionTitle title="Works" id="works" />

  <Entry
    title="ひめぐり ～バラバラな四国の観光情報を、AIで一枚の地図に重ねる～"
    meta="Toma Okugawa, Rawat Achintan, Teoh Ming Jie — 地域創生・社会課題解決 AIコンテスト 2026 presentation topic, E:N BASE"
    date="Jul 2026"
    lang="ja"
    badges={["Software"]}
  >
    An AI-powered map that unifies scattered tourism information across Shikoku into a single view.
  </Entry>
  <Entry
    title="Vocalia – find sounds by voice –"
    meta="Koki Fukuda, Ukyo Okada, Toma Okugawa, Ousuke Ozawa, Riku Murakami — The 37th KOSEN Programming Contest, Preliminary Round Qualifier (Free Style Category), Sunport Hall Takamatsu"
    date="Jun – Oct 2026"
    badges={["Web service"]}
  >
    A web service for finding sounds by voice, selected as a preliminary round qualifier in the free style
    category of the national KOSEN programming contest.
  </Entry>
  <Entry
    title="れしぷろえんじん！ ―レシピをプログラミングするエンジン―"
    meta="Ukyo Okada, Kouki Fukuda, Toma Okugawa, Toya Kimura, Hurano Hirabayasi — The 36th KOSEN Programming Contest, Preliminary Round Qualifier (Free Style Category), Kunibiki Messe"
    date="Jun – Oct 2025"
    lang="ja"
    badges={["Web service"]}
    highlightBadges={["Fighting Spirit Award"]}
  >
    An engine for "programming" cooking recipes, which received the Fighting Spirit Award at the national KOSEN
    programming contest.
  </Entry>
</BaseLayout>
