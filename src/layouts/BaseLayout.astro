---
import "@fontsource-variable/noto-sans-jp";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SideBar from "../components/SideBar.astro";
import { ViewTransitions } from "astro:transitions";

import { SITE_TITLE, SITE_DESCRIPTION, SITE_AUTHOR, CONTACT_EMAIL, TRANSITION_API } from "../config";

const {
  image,
  title,
  description = SITE_DESCRIPTION,
  includeSidebar = true,
  sideBarActiveItemID,
  ogType,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE_AUTHOR}` : SITE_TITLE;
---

<!doctype html>
<html lang="en" data-theme="resume">
  <head>
    <BaseHead title={pageTitle} description={description} image={image} ogType={ogType} />
    {TRANSITION_API && <ViewTransitions />}
  </head>
  <body>
    <div class="bg-base-200 drawer lg:drawer-open">
      <input id="my-drawer" type="checkbox" class="drawer-toggle" aria-label="Open navigation menu" />
      <div class="drawer-content bg-base-200 min-h-screen">
        <Header title={SITE_AUTHOR} showMenuButton={includeSidebar} />
        <div class="p-3 lg:p-4">
          <main
            class="bg-base-100 rounded-2xl shadow-sm w-full max-w-6xl mx-auto p-4 sm:p-6 md:p-10 min-h-[calc(100svh-7.5rem)] lg:min-h-[calc(100svh-9.5rem)]"
          >
            <slot />
          </main>
        </div>
        <Footer />
      </div>
      {includeSidebar && <SideBar sideBarActiveItemID={sideBarActiveItemID} />}
    </div>

    <dialog id="mail-modal" class="modal" aria-labelledby="mail-modal-title">
      <div class="modal-box max-w-sm">
        <h3 id="mail-modal-title" class="font-bold text-lg mb-3">Contact</h3>
        <p class="text-sm text-base-content/70 mb-2">Send an email to:</p>
        <p class="font-mono text-sm bg-base-200 rounded px-3 py-2 mb-2 select-all break-all">{CONTACT_EMAIL}</p>
        <div class="modal-action mt-4 flex flex-wrap gap-2 justify-end">
          <form method="dialog">
            <button class="btn btn-ghost">Cancel</button>
          </form>
          <button class="btn btn-outline btn-primary" onclick="copyContactEmail()">Copy address</button>
          <a class="btn btn-primary" href={`mailto:${CONTACT_EMAIL}`}>Open mail app</a>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button aria-label="Close">close</button>
      </form>
    </dialog>

    <div
      id="copy-toast"
      class="toast toast-end z-50 mb-[env(safe-area-inset-bottom)] mr-[env(safe-area-inset-right)]"
      role="status"
    >
    </div>

    <script is:inline define:vars={{ contactEmail: CONTACT_EMAIL }}>
      window.openMailModal = function () {
        const modal = document.getElementById("mail-modal");
        modal && modal.showModal();
      };
      window.copyContactEmail = function () {
        const toast = document.getElementById("copy-toast");
        const show = function (kind, message) {
          if (!toast) return;
          toast.innerHTML =
            '<div class="alert alert-' + kind + ' text-sm"><span>' + message + "</span></div>";
          setTimeout(function () {
            toast.replaceChildren();
          }, 2500);
        };
        navigator.clipboard.writeText(contactEmail).then(
          function () {
            show("success", "Address copied!");
          },
          function () {
            show("error", "Copy failed");
          }
        );
      };
    </script>
  </body>
</html>
