---
import "@fontsource-variable/noto-sans-jp";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SideBar from "../components/SideBar.astro";
import { ViewTransitions } from "astro:transitions";

import { CONTACT_EMAIL, TRANSITION_API } from "../config";
import { basePathOf, useTranslations, type Locale } from "../i18n/ui";

interface Props {
  image?: string;
  title?: string;
  description?: string;
  includeSidebar?: boolean;
  sideBarActiveItemID?: string;
  ogType?: string;
  locale?: Locale;
  /** Error pages: link the switcher to the home pages and emit no canonical/alternate URLs. */
  isErrorPage?: boolean;
}

const {
  image,
  title,
  description,
  includeSidebar = true,
  sideBarActiveItemID,
  ogType,
  locale = "en",
  isErrorPage = false,
} = Astro.props;

const t = useTranslations(locale);
const basePath = isErrorPage ? "/" : basePathOf(Astro.url.pathname);
const pageTitle = title ? `${title} | ${t("site.author")}` : t("site.title");
const pageDescription = description ?? t("site.description");
---

<!doctype html>
<html lang={locale} data-theme="resume">
  <head>
    <BaseHead
      title={pageTitle}
      description={pageDescription}
      image={image}
      ogType={ogType}
      locale={locale}
      basePath={basePath}
      suppressAlternates={isErrorPage}
    />
    {TRANSITION_API && <ViewTransitions />}
  </head>
  <body>
    <div class="bg-base-200 drawer lg:drawer-open">
      <input id="my-drawer" type="checkbox" class="drawer-toggle" aria-label={t("header.drawerLabel")} />
      <div class="drawer-content bg-base-200 min-h-screen">
        <Header showMenuButton={includeSidebar} locale={locale} basePath={basePath} />
        <div class="p-3 lg:p-4">
          <main
            class="bg-base-100 rounded-2xl shadow-sm w-full max-w-6xl mx-auto p-4 sm:p-6 md:p-10 min-h-[calc(100svh-7.5rem)] lg:min-h-[calc(100svh-9.5rem)]"
          >
            <slot />
          </main>
        </div>
        <Footer locale={locale} />
      </div>
      {includeSidebar && <SideBar sideBarActiveItemID={sideBarActiveItemID} locale={locale} basePath={basePath} />}
    </div>

    <dialog id="mail-modal" class="modal" aria-labelledby="mail-modal-title">
      <div class="modal-box max-w-sm">
        <h3 id="mail-modal-title" class="font-bold text-lg mb-3">{t("modal.title")}</h3>
        <p class="text-sm text-base-content/70 mb-2">{t("modal.sendTo")}</p>
        <p class="font-mono text-sm bg-base-200 rounded px-3 py-2 mb-2 select-all break-all">{CONTACT_EMAIL}</p>
        <div class="modal-action mt-4 flex flex-wrap gap-2 justify-end">
          <form method="dialog">
            <button class="btn btn-ghost">{t("modal.cancel")}</button>
          </form>
          <button class="btn btn-outline btn-primary" onclick="copyContactEmail()">{t("modal.copy")}</button>
          <a class="btn btn-primary" href={`mailto:${CONTACT_EMAIL}`}>{t("modal.open")}</a>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button aria-label={t("modal.cancel")}>close</button>
      </form>
    </dialog>

    <div
      id="copy-toast"
      class="toast toast-end z-50 mb-[env(safe-area-inset-bottom)] mr-[env(safe-area-inset-right)]"
      role="status"
    >
    </div>

    <script
      is:inline
      define:vars={{
        contactEmail: CONTACT_EMAIL,
        copiedMessage: t("modal.copied"),
        copyFailedMessage: t("modal.copyFailed"),
      }}
    >
      window.openMailModal = function () {
        const modal = document.getElementById("mail-modal");
        modal && modal.showModal();
      };
      window.copyContactEmail = function () {
        const toast = document.getElementById("copy-toast");
        const show = function (kind, message) {
          if (!toast) return;
          toast.innerHTML =
            '<div class="alert alert-' + kind + ' text-sm"><span>' + message + "</span></div>";
          setTimeout(function () {
            toast.replaceChildren();
          }, 2500);
        };
        navigator.clipboard.writeText(contactEmail).then(
          function () {
            show("success", copiedMessage);
          },
          function () {
            show("error", copyFailedMessage);
          }
        );
      };
    </script>
  </body>
</html>
