---
import "@fontsource-variable/noto-sans-jp";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SideBar from "../components/SideBar.astro";
import { ViewTransitions } from "astro:transitions";

import { SITE_TITLE, SITE_DESCRIPTION, SITE_AUTHOR, CONTACT_EMAIL, TRANSITION_API } from "../config";

const {
  image,
  title,
  description = SITE_DESCRIPTION,
  includeSidebar = true,
  sideBarActiveItemID,
  ogType,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE_AUTHOR}` : SITE_TITLE;
---

<!doctype html>
<html lang="en" data-theme="resume">
  <head>
    <BaseHead title={pageTitle} description={description} image={image} ogType={ogType} />
    {TRANSITION_API && <ViewTransitions />}
  </head>
  <body>
    <div class="bg-base-200 drawer lg:drawer-open">
      <input id="my-drawer" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content bg-base-200 min-h-screen">
        <Header title={SITE_AUTHOR} showMenuButton={includeSidebar} />
        <div class="p-3 lg:p-4">
          <main class="bg-base-100 rounded-2xl shadow-sm w-full max-w-6xl p-6 md:p-10 min-h-[calc(100vh-7.5rem)]">
            <slot />
          </main>
        </div>
        <Footer />
      </div>
      {includeSidebar && <SideBar sideBarActiveItemID={sideBarActiveItemID} />}
    </div>

    <dialog id="mail-modal" class="modal">
      <div class="modal-box max-w-sm">
        <h3 class="font-bold text-lg mb-3">Contact</h3>
        <p class="text-sm text-base-content/70 mb-2">Send an email to:</p>
        <p class="font-mono text-sm bg-base-200 rounded px-3 py-2 mb-2 select-all break-all">{CONTACT_EMAIL}</p>
        <div class="modal-action mt-4 flex flex-wrap gap-2 justify-end">
          <form method="dialog">
            <button class="btn btn-ghost btn-sm">Cancel</button>
          </form>
          <button class="btn btn-outline btn-primary btn-sm" onclick="copyContactEmail()">Copy address</button>
          <a class="btn btn-primary btn-sm" href={`mailto:${CONTACT_EMAIL}`}>Open mail app</a>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button aria-label="Close">close</button>
      </form>
    </dialog>

    <div id="copy-toast" class="toast toast-end hidden z-50">
      <div class="alert alert-success text-sm">
        <span>Address copied!</span>
      </div>
    </div>

    <script is:inline define:vars={{ contactEmail: CONTACT_EMAIL }}>
      window.openMailModal = function () {
        const modal = document.getElementById("mail-modal");
        modal && modal.showModal();
      };
      window.copyContactEmail = function () {
        navigator.clipboard.writeText(contactEmail).then(function () {
          const toast = document.getElementById("copy-toast");
          if (!toast) return;
          toast.classList.remove("hidden");
          setTimeout(function () {
            toast.classList.add("hidden");
          }, 2500);
        });
      };
    </script>
  </body>
</html>
